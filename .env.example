# Copy to .env and fill in. Never commit .env.

# LLM (any OpenAI-compatible chat completions endpoint, e.g. vLLM)
LLM_BASE_URL=https://llm.example.com/v1/chat/completions
LLM_MODEL=gemma4
LLM_SUPPORTS_SYSTEM_ROLE=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_replier
DATABASE_BASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/
EMAIL_DB=email_replier

# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/
GMAIL_TOKEN_FILE=token.json

# API / dashboard
JWT_SECRET_KEY=change-me
API_CORS_ORIGINS=http://localhost:3000
DASHBOARD_ADMIN_EMAIL=admin@example.com
DASHBOARD_ADMIN_PASSWORD=change-me
SETTINGS_FERNET_KEY=

# Campaigns (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hr@example.com

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Recruiter / company profile used in replies
COMPANY_NAME=Acme Corp
COMPANY_WEBSITE=https://example.com
RECRUITER_NAME=Alex Recruiter
RECRUITER_EMAIL=hr@example.com
RECRUITER_TITLE=Head of People & Talent
LINKEDIN_URL=https://www.linkedin.com/in/your-recruiter-profile/
WORK_LOCATION=

# false = replies are saved as drafts for human review before sending
SEND_EMAILS_DIRECTLY=false

# Observability (optional)
LANGCHAIN_API_KEY=
SLACK_WEBHOOK_URL=
LOG_LEVEL=INFO
